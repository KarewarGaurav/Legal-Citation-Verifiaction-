# Supabase (publishable keys only in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Gemini example:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash-lite
# Optional comma-separated fallbacks if primary fails (defaults: gemini-2.5-pro, gemini-2.5-flash, gemini-3.1-pro-preview)
# LLM_FALLBACK_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-3.1-pro-preview
LLM_API_KEY=
INDIAN_KANOON_API_KEY=

# Statute normalization: preserve_original | normalize_to_current_codes (default)
NORMALIZATION_MODE=normalize_to_current_codes
